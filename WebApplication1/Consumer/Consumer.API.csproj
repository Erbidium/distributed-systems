    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>69faff9c-2b9d-48d5-88d8-8c0202b3d334</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
