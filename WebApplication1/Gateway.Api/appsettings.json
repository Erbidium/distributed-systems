{
  "ReverseProxy": {
    "Routes": {
      "consumer": {
        "ClusterId": "consumer",
        "Match": { "Path": "/consumer/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/consumer" }
        ]
      }
    },
    "Clusters": {
      "consumer": {
        "Destinations": {
          "d1": { "Address": "http://consumer:8080/" }
        }
      }
    }
  }
}
